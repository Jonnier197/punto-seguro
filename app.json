{
  "expo": {
    "name": "Punto Seguro",
    "slug": "punto-seguro",
    "scheme": "punto-seguro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo_punto_seguro.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3B70"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "package": "com.jonnier197.puntoseguro",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir a Punto Seguro acceder a tu ubicación."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5334815455665872~7213300599"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-router",
      "expo-splash-screen",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "038943dc-e77b-4876-a2d4-dcb403865eab"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/038943dc-e77b-4876-a2d4-dcb403865eab"
    }
  }
}
