{
  "expo": {
    "name": "Punto Seguro",
    "slug": "punto-seguro",
    "scheme": "punto-seguro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.jonnier197.puntoseguro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir a Punto Seguro acceder a tu ubicación."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "038943dc-e77b-4876-a2d4-dcb403865eab"
      }
    }
  }
}